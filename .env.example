# Copy to .env and fill in. Never commit the real .env.

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/la_forge_db"

# Signs the session cookies. Generate with: openssl rand -base64 32
# Changing this signs everyone out immediately.
NEXTAUTH_SECRET="replace-me"

# Base URL of the app (used by NextAuth callbacks)
NEXTAUTH_URL="http://localhost:3000"

# Coach login. Set both, run `npm run coach`, then delete COACH_PASSWORD again
# so the password is not left sitting in a file. Re-run any time to change it.
COACH_EMAIL="coach@laforge.local"
COACH_PASSWORD=""
