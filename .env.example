# Copy to .env and fill in. Never commit the real .env.

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/la_forge_db"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me"

# Base URL of the app (used by NextAuth callbacks)
NEXTAUTH_URL="http://localhost:3000"

# Coach login created by `npm run db:seed` on a fresh database.
# Only needed the first time — re-seeding never touches an existing account.
# This repository is public: keep the real account name out of it, and treat the
# username as a second secret rather than something an attacker already knows.
SEED_COACH_EMAIL="coach@laforge.local"
SEED_COACH_NAME="choose-a-coach-username"
SEED_COACH_PASSWORD="choose-a-strong-password"
